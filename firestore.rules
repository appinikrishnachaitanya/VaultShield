rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {

  // User profile
  match /users/{uid}/settings/profile {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['displayName', 'language'])
    && request.resource.data.displayName is string
    && request.resource.data.displayName.size() >= 2
    && request.resource.data.displayName.size() <= 40
    && request.resource.data.language in ['en', 'hi'];
  }

  // Family circle & alerts (read-only from client)
  match /users/{uid}/{collection}/{doc} {
   allow read: if request.auth != null && request.auth.uid == uid && collection in ['family', 'alerts'];
   allow write: if false;
  }

  // Private Diary — PIN lock config (salt + canary, never the PIN itself)
  match /users/{uid}/settings/diaryLock {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['salt', 'canaryIv', 'canaryData'])
    && request.resource.data.salt is string
    && request.resource.data.canaryIv is string
    && request.resource.data.canaryData is string;
  }

  // Private Diary — encrypted entries (opaque ciphertext blobs only)
  match /diary/{uid}/entries/{entryId} {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['id', 'date', 'createdAt', 'iv', 'data'])
    && request.resource.data.id is string
    && request.resource.data.date is string
    && request.resource.data.createdAt is number
    && request.resource.data.iv is string
    && request.resource.data.data is string;
  }

  // Deny everything else
  match /{document=**} { allow read, write: if false; }
 }
}
